# Copy to .env and fill in — NEVER commit .env or any real credential.
# DRY_RUN=True is the safe default. Set DRY_RUN=False ONLY for a live run
# the client explicitly approved, with a real account + webhook in place.
DRY_RUN=True
LIVE_MODE=False
# Explicit live confirmation — required (with auth_state.json) for any live
# run. Set to "yes" ONLY after the client accepted the speculative-listing
# risk in writing. Anything else blocks a live start.
LIVE_CONFIRM=
FLASK_HOST=127.0.0.1
FLASK_PORT=5002
FLASK_DEBUG=False
LOG_LEVEL=INFO
DATABASE_PATH=data/listings.db

# Viagogo seller portal (do NOT put username/password here in plain text;
# log in once in a browser and save the session, see DELIVERY.md § Live checklist)
VIAGOGO_SELLER_URL=https://www.viagogo.com/sell
VIAGOGO_SESSION_FILE=auth_state.json
# Optional proxy, e.g. http://user:pass@host:port  (leave empty = no proxy)
VIAGOGO_PROXY=
PLAYWRIGHT_HEADLESS=True
# Playwright page timeout in milliseconds
VIAGOGO_TIMEOUT_MS=60000

# Discord — paste the client's real webhook URL here (or in the web UI).
# Leave empty in dry-run; the test button will tell you it is missing.
DISCORD_WEBHOOK_URL=

# Mock portal for end-to-end testing without Viagogo (file:// URL or local http)
MOCK_PORTAL_URL=

# Opportunity Scanner — live market scrape is OFF by default. A live scan
# needs SCAN_LIVE=True here AND {"live": true} in the scan request.
# Mock/sample scans (default) use labelled sample numbers, no network.
SCAN_LIVE=False
# Minimum seconds between live market pages (politeness / rate limits)
SCAN_DELAY_S=5

# Stealth / anti-detection (v1.2.1, on by default). Randomised desktop
# UA/viewport per launch, seller-store locale/timezone, init script
# hiding the usual automation tells, typing/click jitter. Reduces
# detection risk — does NOT guarantee invisibility and NEVER bypasses
# a CAPTCHA / Cloudflare challenge by itself (the bot stops if one appears).
# Set STEALTH_ENABLED=False to disable (e.g. for debugging).
STEALTH_ENABLED=True
# Optional comma-separated UA override, e.g. "Mozilla/5.0 (...) Chrome/141.0.0.0, ..."
STEALTH_USER_AGENTS=
STEALTH_LOCALE=en-US
STEALTH_TIMEZONE=America/New_York

# NopeCHA CAPTCHA solver (v1.2.2, OPTIONAL and OFF by default).
# The bot works without it: with no key it stops on a challenge.
# To enable: get a key at https://nopecha.com (free tier: 100
# recognitions/day; Starter $4.99/month), then either set it here or
# paste it in the dashboard (Settings > CAPTCHA Solver) — the dashboard
# key is stored in the local SQLite config, shown back only masked.
# NOPECHA_ENABLED=true + a key = the bot attempts ONE solve per
# challenge page (Token API first). Solving a CAPTCHA may violate
# Viagogo's terms and increases account-ban risk; NopeCHA does not
# guarantee a solve, and a Cloudflare interstitial (no sitekey) cannot
# be solved by the Token API. NEVER commit a real key.
NOPECHA_API_KEY=
NOPECHA_ENABLED=False
